# thomas-core 环境变量样例 —— 全部留空，禁止把真实凭证写进仓库。
# 复制为 backend/.env 后按需填值；生产必须覆盖 SECRET_KEY 与 JWT_SECRET。

# --- 必填（生产） ---
SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- 运行 ---
FLASK_ENV=production
FLASK_PORT=5300
THOMAS_SCHEMA_SPLIT=1
DATABASE_PATH=
CORS_ORIGINS=
GIT_COMMIT=

# --- Supabase 统一认证（可选，配了才走 JWKS 验签）---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# --- 第三方登录（可选）---
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_DEV_MODE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_OAUTH_REGION=cn

# --- LLM / Embedding（ask 走真 RAG 时才需要）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER_ORDER=deepseek,ollama
OLLAMA_HOST=http://127.0.0.1:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBED_PROVIDER_ORDER=openai,ollama,deepseek
EMBED_MODEL=nomic-embed-text:latest

# --- RAG / Chroma ---
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=looma_knowledge
# 相对路径按 DATABASE_PATH 所在目录解析，不再相对进程 cwd
POETRY_CHROMA_PATH=poetry_full

# --- 配额 ---
FREE_DAILY_LIMIT=30
SUPPORTER_DAILY_LIMIT=999999
PRO_DAILY_LIMIT=999999

# --- 跨产品身份桥 ---
ETHOS_AUTH_SECRET=
